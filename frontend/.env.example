# ==============================================================================
# Research Arena — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the frontend development server:
#   cp .env.example .env    (Linux / macOS)
#   Copy-Item .env.example .env    (PowerShell)
# ==============================================================================

# Backend REST API base URL.
# In local development, the FastAPI backend listens at http://127.0.0.1:8000/api.
# The Vite development server (port 3000) also proxies all '/api' requests to port 8000.
#
# Default: "http://127.0.0.1:8000/api"
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
