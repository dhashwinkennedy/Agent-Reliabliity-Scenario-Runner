# ==============================================================================
# Research Arena — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the backend service:
#   cp .env.example .env    (Linux / macOS)
#   Copy-Item .env.example .env    (PowerShell)
#
# NEVER commit your actual '.env' file or any real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Settings
# ------------------------------------------------------------------------------
# Connection string for SQLite database.
# Default: sqlite:///./platform.db (creates platform.db in backend root)
# Optional: Keep default for standard local development
DATABASE_URL=sqlite:///./platform.db

# Root directory for local artifact and snapshot storage.
# Default: ./data (creates datasets, snapshots, results, exports directories)
STORAGE_DIR=./data

# ------------------------------------------------------------------------------
# 2. Security & Credential Encryption (REQUIRED FOR PROVIDER REGISTRATION)
# ------------------------------------------------------------------------------
# Secret key used to encrypt LLM provider API credentials at rest with Fernet (AES-128-CBC + HMAC-SHA256).
# REQUIRED if registering LLM providers with API keys (e.g. OpenRouter, OpenAI, Gemini).
# Must be a 32-byte URL-safe base64-encoded string (exactly 44 characters ending with '=').
#
# IMPORTANT: Each developer must generate their own key. If you change this key later,
# any previously stored encrypted API keys in platform.db will become undecryptable.
#
# To generate a valid key, run either command:
#   Python:     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PowerShell: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. HTTP Server, Host & CORS Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# Default: http://localhost:3000 (standard Vite frontend dev server port)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted host headers allowed by Starlette TrustedHostMiddleware.
# Default: 127.0.0.1,localhost,testserver
TRUSTED_HOSTS=127.0.0.1,localhost,testserver

# Maximum upload payload size in bytes (e.g., 52428800 = 50 MB)
MAX_UPLOAD_BYTES=52428800

# Maximum page size for paginated API listings (runs, evaluations, datasets)
MAX_PAGE_SIZE=500

# Maximum number of sample errors to report when validating corrupted JSONL datasets
JSONL_ERROR_SAMPLE_LIMIT=20

# ------------------------------------------------------------------------------
# 4. Agent Execution & Network Isolation Controls
# ------------------------------------------------------------------------------
# Allow custom HTTP-based agents on local/private loopback addresses.
# Default: false (set to true only for local custom agent inter-process development)
ALLOW_LOCAL_HTTP_AGENTS=false

# Timeout in seconds for custom external HTTP agents
HTTP_AGENT_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 5. LLM Provider Execution Settings
# ------------------------------------------------------------------------------
# Allow provider endpoints on local/private loopback addresses (e.g. local Ollama / vLLM).
# Default: false (set to true if connecting to local Ollama on http://localhost:11434/v1)
ALLOW_LOCAL_LLM_PROVIDERS=false

# Default timeout in seconds for LLM provider HTTP completions and model discovery
PROVIDER_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 6. Optional Live Search Integration (Tavily)
# ------------------------------------------------------------------------------
# Tavily Search API key for optional live financial news retrieval (Baseline agent only).
# Optional: Benchmark evaluations use frozen dataset scenarios by default.
TAVILY_API_KEY=
TAVILY_SEARCH_ENABLED=false
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15
